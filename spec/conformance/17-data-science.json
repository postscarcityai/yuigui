{
  "version": "YL v0",
  "area": "data and science: chart, stat, math, step, calc, table units and sort",
  "vectors": [
    {
      "name": "chart: type, title, x and y lists",
      "input": "chart line \"Weight\" x=Mon|Tue|Wed y=180|179|178.5",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n1",
          "props": {
            "type": "line",
            "title": "Weight",
            "x": [
              "Mon",
              "Tue",
              "Wed"
            ],
            "y": [
              180,
              179,
              178.5
            ]
          }
        }
      ]
    },
    {
      "name": "chart: no type word, type not sent",
      "input": "chart x=1|2 y=3|4",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n1",
          "props": {
            "x": [
              1,
              2
            ],
            "y": [
              3,
              4
            ]
          }
        }
      ]
    },
    {
      "name": "chart: only the first chart type word is the type",
      "input": "chart bar line chart",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n1",
          "props": {
            "type": "bar",
            "title": "line chart"
          }
        }
      ]
    },
    {
      "name": "chart: a quoted type word is title text",
      "input": "chart \"pie\" x=a|b y=1|2",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n1",
          "props": {
            "title": "pie",
            "x": [
              "a",
              "b"
            ],
            "y": [
              1,
              2
            ]
          }
        }
      ]
    },
    {
      "name": "chart: every chart type",
      "input": "chart line\nchart bar\nchart area\nchart scatter\nchart pie\nchart donut",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n1",
          "props": {
            "type": "line"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n2",
          "props": {
            "type": "bar"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n3",
          "props": {
            "type": "area"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n4",
          "props": {
            "type": "scatter"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n5",
          "props": {
            "type": "pie"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n6",
          "props": {
            "type": "donut"
          }
        }
      ]
    },
    {
      "name": "chart: a single y value is still a list",
      "input": "chart bar x=Total y=5",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n1",
          "props": {
            "type": "bar",
            "x": [
              "Total"
            ],
            "y": [
              5
            ]
          }
        }
      ]
    },
