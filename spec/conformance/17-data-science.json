    {
      "name": "chart: a patch re-sends a series",
      "input": "chart@w line x=a|b y=1|2\n~w y=3|4",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "w",
          "props": {
