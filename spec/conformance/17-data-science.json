            "x": [
              1,
              2
            ],
            "y": [
              3,
              4
            ],
            "err": [
              0.2,
              0.1
            ]
          }
        }
      ]
    },
    {
      "name": "chart: inline errors on y2 go to err2",
      "input": "chart bar x=a|b y=1|2 y2=3±0.3|4±0.4",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n1",
          "props": {
            "type": "bar",
            "x": [
              "a",
              "b"
            ],
            "y": [
              1,
              2
            ],
            "y2": [
              3,
              4
            ],
            "err2": [
              0.3,
              0.4
            ]
          }
        }
      ]
    },
    {
      "name": "chart: an explicit err list wins over inline ±",
      "input": "chart bar x=a|b y=1±0.1|2±0.2 err=0.5|0.6",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n1",
          "props": {
            "type": "bar",
            "x": [
              "a",
              "b"
            ],
            "y": [
              1,
              2
            ],
            "err": [
              0.5,
              0.6
            ]
          }
        }
      ]
    },
    {
      "name": "chart: a single err value is a one item list",
      "input": "chart scatter x=1|2|3 y=2|4|6 err=0.3",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n1",
