            "y": [
              1,
              2
            ],
            "y2": [
              3,
              4
            ],
            "y3": [
              5,
              6
            ],
            "names": [
              "A",
              "B",
              "C"
            ]
          }
        }
      ]
    },
    {
      "name": "chart: inline ± becomes a number and an err list",
      "input": "chart bar x=a|b|c y=10±1|12|9.5±0.5",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n1",
          "props": {
            "type": "bar",
            "x": [
              "a",
              "b",
              "c"
            ],
            "y": [
              10,
              12,
              9.5
            ],
            "err": [
              1,
              0,
              0.5
            ]
          }
        }
      ]
    },
    {
      "name": "chart: ASCII +- works like ±",
      "input": "chart scatter x=1|2 y=3+-0.2|4+-0.1",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "chart",
          "id": "n1",
