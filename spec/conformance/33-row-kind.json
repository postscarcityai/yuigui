    {
      "name": "kind= must be done, now or next",
      "input": "~w1 kind=later",
      "known": {
        "w1": "now"
      },
      "expected": [
        {
          "op": "error",
          "screen": "1"
        }
      ],
      "error": true
    },
    {
      "name": "kind= as a flag is not a kind",
