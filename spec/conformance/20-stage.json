        {
          "op": "focus",
          "screen": "full"
        },
        {
          "op": "add",
          "screen": "full",
          "preset": "timer",
          "id": "n1",
          "props": {
            "work": 60,
            "label": "Plank"
          }
        },
        {
          "op": "add",
          "screen": "full",
          "preset": "ask",
          "id": "n2",
          "props": {
            "q": "Done?"
          }
        }
      ],
      "stage": [
        "n1",
        "n2"
      ]
    },
    {
      "name": "one line to the stage",
      "input": ">full timer 60 Plank\nask Done?",
