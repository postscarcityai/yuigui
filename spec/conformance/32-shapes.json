{
  "version": "YL v0",
  "area": "shapes",
  "vectors": [
    {
      "name": "shapes: title and caption, shapes join it",
      "input": "shapes \"How it flows\" caption=\"Asks land on the board.\"\nshape circle You\nshape arrow\nshape box Board",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "shapes",
          "id": "n1",
          "props": {
            "title": "How it flows",
            "caption": "Asks land on the board."
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "shape",
          "id": "n2",
          "in": "n1",
          "props": {
            "kind": "circle",
            "label": "You"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "shape",
          "id": "n3",
          "in": "n1",
          "props": {
            "kind": "arrow"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "shape",
          "id": "n4",
          "in": "n1",
          "props": {
            "kind": "box",
            "label": "Board"
          }
        }
      ]
    },
