          }
        }
      ]
    },
    {
      "name": "compare: notes as options",
      "input": "compare /a.jpg /b.jpg notes=\"Sage wall\"|Rug",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "compare",
