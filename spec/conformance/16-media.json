{
  "version": "YL v0",
  "area": "media: gallery, video, compare, storyboard, image +edit",
  "vectors": [
    {
      "name": "gallery: urls become items, other text is the title",
      "input": "gallery \"Studio shoot\" /g/1.jpg https://x.com/2.jpg",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "gallery",
          "id": "n1",
          "props": {
            "title": "Studio shoot",
            "items": [
              "/g/1.jpg",
              "https://x.com/2.jpg"
            ]
          }
        }
      ]
    },
    {
      "name": "gallery: default layout is not sent",
      "input": "gallery /a.jpg /b.jpg",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "gallery",
          "id": "n1",
          "props": {
            "items": [
              "/a.jpg",
              "/b.jpg"
            ]
          }
        }
      ]
    },
    {
      "name": "gallery: layout, pick and max",
      "input": "gallery /a.jpg /b.jpg /c.jpg layout=row3d +pick max=2",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "gallery",
          "id": "n1",
          "props": {
            "items": [
              "/a.jpg",
              "/b.jpg",
              "/c.jpg"
            ],
            "pick": true,
            "layout": "row3d",
            "max": 2
          }
        }
      ]
    },
    {
      "name": "gallery: inline captions, three spellings",
      "input": "gallery /a.jpg|Wheel \"/b.jpg|Sage mugs\" /c.jpg|\"Kiln room\"",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "gallery",
          "id": "n1",
          "props": {
            "items": [
              "/a.jpg",
              "/b.jpg",
              "/c.jpg"
            ],
            "caps": [
              "Wheel",
              "Sage mugs",
              "Kiln room"
            ]
          }
        }
      ]
    },
    {
      "name": "gallery: captions pad with empty strings",
      "input": "gallery /a.jpg /b.jpg|Two /c.jpg",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "gallery",
          "id": "n1",
          "props": {
            "items": [
              "/a.jpg",
              "/b.jpg",
              "/c.jpg"
            ],
            "caps": [
              "",
              "Two",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "gallery: items and caps as key/values",
      "input": "gallery items=/a.jpg|/b.jpg caps=\"First one|Second one\" layout=grid",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "gallery",
          "id": "n1",
          "props": {
            "items": [
              "/a.jpg",
              "/b.jpg"
            ],
            "caps": [
              "First one",
              "Second one"
            ],
            "layout": "grid"
          }
        }
      ]
    },
    {
      "name": "gallery: numeric captions stay text",
      "input": "gallery /a.jpg /b.jpg caps=1|2",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "gallery",
          "id": "n1",
          "props": {
            "items": [
              "/a.jpg",
              "/b.jpg"
            ],
            "caps": [
              "1",
              "2"
            ]
          }
        }
      ]
    },
    {
      "name": "gallery: urls with query strings",
      "input": "gallery https://img.test/a.jpg?w=400&q=80 /b.mp4",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "gallery",
          "id": "n1",
          "props": {
            "items": [
              "https://img.test/a.jpg?w=400&q=80",
              "/b.mp4"
            ]
          }
        }
      ]
    },
    {
      "name": "gallery: no urls is still a gallery",
      "input": "gallery Coming soon",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "gallery",
          "id": "n1",
          "props": {
            "title": "Coming soon"
          }
        }
      ]
    },
    {
      "name": "gallery: patch the layout by id",
      "input": "gallery@shoot /a.jpg /b.jpg\n~shoot layout=feed",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "gallery",
          "id": "shoot",
          "props": {
            "items": [
              "/a.jpg",
              "/b.jpg"
            ]
          }
        },
        {
          "op": "patch",
          "screen": "1",
          "target": "shoot",
          "props": {
            "layout": "feed"
          }
        }
      ]
    },
    {
      "name": "video: url and caption",
      "input": "video /demo/reel.mp4 Launch reel",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "video",
          "id": "n1",
          "props": {
            "src": "/demo/reel.mp4",
            "caption": "Launch reel"
          }
        }
      ]
    },
    {
      "name": "video: flags",
      "input": "video https://cdn.test/a.mp4 +loop +auto +mute",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "video",
          "id": "n1",
          "props": {
            "src": "https://cdn.test/a.mp4",
            "loop": true,
            "auto": true,
            "mute": true
          }
        }
      ]
    },
    {
      "name": "video: poster by key",
      "input": "video /a.mp4 poster=/a.jpg",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "video",
          "id": "n1",
          "props": {
            "src": "/a.mp4",
            "poster": "/a.jpg"
          }
        }
      ]
    },
    {
      "name": "video: no url is a prompt",
      "input": "video \"slow pan across glazed mugs\"",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "video",
          "id": "n1",
          "props": {
            "prompt": "slow pan across glazed mugs"
          }
        }
      ]
    },
    {
      "name": "compare: before, after, title",
      "input": "compare /before.jpg /after.jpg Living room",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "compare",
          "id": "n1",
          "props": {
