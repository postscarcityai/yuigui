            "after": "/after.jpg",
            "title": "Living room"
          }
        }
      ]
    },
    {
      "name": "compare: modes",
      "input": "compare /a.jpg /b.jpg mode=side\ncompare /a.jpg /b.jpg mode=toggle",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "compare",
          "id": "n1",
          "props": {
            "before": "/a.jpg",
            "after": "/b.jpg",
