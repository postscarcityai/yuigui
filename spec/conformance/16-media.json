        {
          "op": "add",
          "screen": "1",
          "preset": "compare",
          "id": "n2",
          "props": {
            "before": "/a.jpg",
            "after": "/b.jpg",
            "mode": "toggle"
          }
        }
      ]
    },
    {
      "name": "compare: notes quoted whole split on |",
      "input": "compare /a.jpg /b.jpg notes=\"Sage wall|New plant\"",
