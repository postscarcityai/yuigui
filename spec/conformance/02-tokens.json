{
  "version": "YL v0",
  "area": "tokens",
  "vectors": [
    {
      "name": "quoted string keeps spaces",
      "input": "ask \"Log this set?\"",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "ask",
          "id": "n1",
          "props": {
            "q": "Log this set?"
          }
        }
      ]
    },
    {
      "name": "bare words join with single spaces",
      "input": "ask   Log   this   set?",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "ask",
          "id": "n1",
          "props": {
            "q": "Log this set?"
          }
        }
      ]
    },
    {
      "name": "escaped quote and backslash inside quotes",
      "input": "say \"She said \\\"hi\\\" and left a \\\\\"",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "say",
          "id": "n1",
          "props": {
            "text": "She said \"hi\" and left a \\"
          }
        }
      ]
    },
    {
      "name": "backslash outside quotes is literal",
      "input": "say C:\\path\\to",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "say",
          "id": "n1",
          "props": {
            "text": "C:\\path\\to"
          }
        }
      ]
    },
    {
      "name": "quotes inside a token",
      "input": "say pre\"fix and\"post",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "say",
          "id": "n1",
          "props": {
            "text": "prefix andpost"
          }
        }
      ]
    },
    {
      "name": "unterminated quote runs to end of line",
      "input": "ask \"Log this set",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "ask",
          "id": "n1",
          "props": {
            "q": "Log this set"
          }
        }
      ]
    },
    {
      "name": "options split on pipe",
      "input": "choose Split? Push|Pull|Legs",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "choose",
          "id": "n1",
          "props": {
            "options": [
              "Push",
              "Pull",
              "Legs"
            ],
            "q": "Split?"
          }
        }
      ]
    },
    {
      "name": "quoted options",
      "input": "choose When? \"3:00 pm\"|\"4:00 pm\"",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "choose",
          "id": "n1",
          "props": {
            "options": [
              "3:00 pm",
              "4:00 pm"
            ],
            "q": "When?"
          }
        }
      ]
    },
    {
      "name": "quoted part next to bare part",
      "input": "pick Gear \"Pull-up bar\"|Bands",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "pick",
          "id": "n1",
          "props": {
            "options": [
              "Pull-up bar",
              "Bands"
            ],
            "q": "Gear"
          }
        }
      ]
    },
    {
      "name": "pipe inside quotes is not a split",
      "input": "say \"a|b\"",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "say",
          "id": "n1",
          "props": {
            "text": "a|b"
          }
        }
      ]
    },
    {
      "name": "key=value number",
      "input": "timer 60 rounds=3",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "timer",
          "id": "n1",
          "props": {
            "work": 60,
            "rounds": 3
          }
        }
      ]
    },
    {
      "name": "key=value decimals and negatives",
      "input": "slide Temp min=-10 max=2.5 step=0.5",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "slide",
          "id": "n1",
          "props": {
            "label": "Temp",
            "min": -10,
            "max": 2.5,
            "step": 0.5
          }
        }
      ]
    },
    {
      "name": "key=value booleans",
      "input": "timer 60 sound=off auto=on up=false",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "timer",
          "id": "n1",
          "props": {
            "work": 60,
            "sound": false,
            "auto": true,
            "up": false
          }
        }
      ]
    },
    {
      "name": "key=value true stays boolean",
      "input": "timer 60 up=true",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "timer",
          "id": "n1",
          "props": {
            "work": 60,
            "up": true
          }
        }
      ]
    },
    {
      "name": "quoted key=value stays text",
      "input": "card Leg cta=\"5\" sub=\"on\"",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "card",
          "id": "n1",
          "props": {
            "title": "Leg",
            "cta": "5",
            "sub": "on"
          }
        }
      ]
    },
    {
      "name": "key=value with spaces needs quotes",
      "input": "card Leg cta=\"Start workout\"",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "card",
          "id": "n1",
