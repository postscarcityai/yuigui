{
  "version": "YL v0",
  "area": "menu",
  "vectors": [
    {
      "name": "review item with an id and a sub",
      "input": "menu review@dana \"Invite Dana?\" sub=\"requested yesterday\"",
      "menu": {
        "review": [
          {
            "id": "dana",
            "label": "Invite Dana?",
            "sub": "requested yesterday"
          }
        ],
        "backlog": [],
        "shortcut": []
      },
      "expected": [
        {
          "op": "menu",
          "screen": "1",
          "id": "dana",
          "props": {
            "bucket": "review",
            "label": "Invite Dana?",
            "sub": "requested yesterday"
          }
        }
      ]
    },
    {
      "name": "backlog item",
      "input": "menu backlog@deload \"Deload week plan\" sub=drafting",
      "menu": {
        "review": [],
        "backlog": [
          {
            "id": "deload",
            "label": "Deload week plan",
            "sub": "drafting"
          }
        ],
        "shortcut": []
      },
      "expected": [
        {
          "op": "menu",
          "screen": "1",
          "id": "deload",
          "props": {
            "bucket": "backlog",
            "label": "Deload week plan",
            "sub": "drafting"
          }
        }
      ]
    },
    {
      "name": "shortcut with no id is known by its label",
      "input": "menu shortcut \"Start today's workout\"",
      "menu": {
        "review": [],
        "backlog": [],
        "shortcut": [
          {
            "id": "start-today-s-workout",
            "label": "Start today's workout"
          }
        ]
      },
      "expected": [
        {
          "op": "menu",
          "screen": "1",
          "id": "start-today-s-workout",
          "props": {
            "bucket": "shortcut",
            "label": "Start today's workout"
          }
        }
      ]
    },
    {
      "name": "unquoted label words join with single spaces",
      "input": "menu shortcut   Log   a meal",
      "menu": {
        "review": [],
        "backlog": [],
        "shortcut": [
          {
            "id": "log-a-meal",
            "label": "Log a meal"
          }
        ]
      },
      "expected": [
        {
          "op": "menu",
          "screen": "1",
          "id": "log-a-meal",
          "props": {
            "bucket": "shortcut",
            "label": "Log a meal"
          }
        }
      ]
    },
    {
      "name": "shortcut with say=",
      "input": "menu shortcut@log \"Log a meal\" say=\"Log a meal: \"",
      "menu": {
        "review": [],
        "backlog": [],
        "shortcut": [
          {
            "id": "log",
            "label": "Log a meal",
            "say": "Log a meal: "
          }
        ]
      },
      "expected": [
        {
          "op": "menu",
          "screen": "1",
          "id": "log",
          "props": {
            "bucket": "shortcut",
            "label": "Log a meal",
            "say": "Log a meal: "
          }
        }
      ]
    },
    {
      "name": "show= and url= stay text",
      "input": "menu backlog@w \"Leg day\" show=\"leg day\"\nmenu review@pr \"Read the PR\" url=https://example.com/pr/7",
      "menu": {
        "review": [
          {
            "id": "pr",
            "label": "Read the PR",
            "url": "https://example.com/pr/7"
          }
        ],
        "backlog": [
          {
            "id": "w",
            "label": "Leg day",
            "show": "leg day"
          }
        ],
        "shortcut": []
      },
      "expected": [
        {
          "op": "menu",
          "screen": "1",
          "id": "w",
          "props": {
            "bucket": "backlog",
            "label": "Leg day",
            "show": "leg day"
          }
        },
        {
          "op": "menu",
          "screen": "1",
          "id": "pr",
          "props": {
            "bucket": "review",
            "label": "Read the PR",
            "url": "https://example.com/pr/7"
          }
        }
      ]
    },
