    {
      "name": "no counter: the next add is still n1",
      "input": "menu review@a \"A\"\nask \"Ready?\"",
      "expected": [
        {
          "op": "menu",
          "screen": "1",
          "id": "a",
          "props": {
            "bucket": "review",
            "label": "A"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "ask",
          "id": "n1",
          "props": {
            "q": "Ready?"
          }
        }
      ]
    },
    {
      "name": "rides the focused screen",
      "input": ">2\nmenu shortcut@go \"Go\"",
      "expected": [
        {
          "op": "focus",
          "screen": "2"
        },
        {
          "op": "menu",
          "screen": "2",
          "id": "go",
          "props": {
            "bucket": "shortcut",
            "label": "Go"
          }
        }
      ]
    },
    {
      "name": "leaves an open group alone",
      "input": "deck\npage \"One\"\nmenu backlog@x \"Later\"\npage \"Two\"",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "deck",
          "id": "n1",
          "props": {}
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "page",
          "id": "n2",
          "in": "n1",
          "props": {
            "title": "One"
          }
        },
        {
          "op": "menu",
          "screen": "1",
          "id": "x",
          "props": {
            "bucket": "backlog",
            "label": "Later"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "page",
          "id": "n3",
          "in": "n1",
          "props": {
            "title": "Two"
          }
        }
      ]
    },
