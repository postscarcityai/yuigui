          "props": {
            "work": 600
          }
        },
        {
          "op": "add",
          "screen": "3",
          "preset": "say",
          "id": "n1",
          "props": {
            "text": "done"
          }
        }
      ],
      "stage": [],
      "pages": [
        3
      ]
    },
    {
