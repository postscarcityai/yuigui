{
 "version": "YL v0",
 "area": "flow: Mermaid flows, their graph and routes (JS only until the native ports; see README)",
 "vectors": [
  {
   "name": "saved flow: flow and a name",
   "input": "flow website-intake",
   "expected": [
    {
     "op": "add",
     "screen": "1",
     "preset": "flow",
     "id": "n1",
     "props": {
      "title": "website-intake"
     }
    }
   ]
  },
  {
   "name": "saved flow: the next line is YL again",
   "input": "flow website-intake submit=\"Send brief\"\nsay \"Here we go.\"",
   "expected": [
    {
     "op": "add",
     "screen": "1",
     "preset": "flow",
     "id": "n1",
     "props": {
      "title": "website-intake",
      "submit": "Send brief"
     }
    },
    {
     "op": "add",
     "screen": "1",
     "preset": "say",
     "id": "n2",
     "props": {
      "text": "Here we go."
     }
    }
   ]
  },
  {
   "name": "inline: steps as node labels, one path",
   "input": "flow@checkin \"Check-in\"\nflowchart TD\n  sleep[slide Sleep 1-10] --> sore[pick Sore? Legs|Back|None] --> note[mic Anything else?]\nend",
   "expected": [
    {
     "op": "add",
     "screen": "1",
     "preset": "flow",
     "id": "checkin",
     "props": {
      "title": "Check-in"
     }
    },
    {
     "op": "patch",
     "screen": "1",
     "target": "checkin",
     "props": {
      "dir": "TD",
      "start": "sleep",
      "nodes": [
       {
        "id": "sleep",
        "preset": "slide",
        "props": {
         "min": 1,
         "max": 10,
         "label": "Sleep"
        }
       },
       {
        "id": "sore",
        "preset": "pick",
        "props": {
         "options": [
          "Legs",
          "Back",
          "None"
         ],
         "q": "Sore?"
        }
       },
       {
        "id": "note",
        "preset": "mic",
        "props": {
         "prompt": "Anything else?"
        }
       }
      ],
      "edges": [
       {
        "from": "sleep",
        "to": "sore"
       },
       {
        "from": "sore",
        "to": "note"
       }
      ],
      "source": "flowchart TD\n  sleep[slide Sleep 1-10] --> sore[pick Sore? Legs|Back|None] --> note[mic Anything else?]"
     }
    }
   ]
  },
  {
   "name": "inline: %% comments carry the steps, labels stay for the chart",
   "input": "flow@scope \"Scope a project\"\nflowchart LR\n  %% what: ask \"What are you making?\" App|Site|Other\n  what{What?} --> when\n  %% when: form \"Timing\" start:date launch:date\n  when[Dates]\nend",
   "expected": [
    {
     "op": "add",
     "screen": "1",
     "preset": "flow",
     "id": "scope",
     "props": {
      "title": "Scope a project"
     }
    },
    {
     "op": "patch",
     "screen": "1",
     "target": "scope",
     "props": {
      "dir": "LR",
      "start": "what",
      "nodes": [
       {
        "id": "what",
        "label": "What?",
        "preset": "ask",
        "props": {
         "options": [
          "App",
          "Site",
          "Other"
         ],
         "q": "What are you making?"
        }
       },
       {
        "id": "when",
        "label": "Dates",
        "preset": "form",
        "props": {
         "fields": [
          {
           "key": "start",
           "type": "date"
          },
          {
           "key": "launch",
           "type": "date"
          }
         ],
         "title": "Timing"
        }
       }
      ],
      "edges": [
       {
        "from": "what",
        "to": "when"
       }
      ],
      "source": "flowchart LR\n  %% what: ask \"What are you making?\" App|Site|Other\n  what{What?} --> when\n  %% when: form \"Timing\" start:date launch:date\n  when[Dates]"
     }
    }
   ]
  },
