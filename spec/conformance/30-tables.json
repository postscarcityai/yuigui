     "screen": "1",
     "name": "lifts",
     "cols": [
      {
       "name": "Day",
       "type": "date"
      },
      {
       "name": "Lift",
       "type": "text"
      },
      {
       "name": "Weight",
       "type": "number",
       "unit": "lb"
      },
      {
       "name": "Done",
       "type": "bool"
      }
     ]
    }
   ]
  },
  {
   "name": "table create: a unit only on number columns",
   "input": "table create t Note:text:words",
   "expected": [
    {
     "op": "error",
     "screen": "1"
    }
   ],
   "error": true
  },
  {
   "name": "table create: unknown type is an error",
