    {
      "name": "map: title and caption, parts join it",
      "input": "map \"The Mongol Empire, 1279\" caption=\"Korea to Hungary.\"\narea Empire MN|CN|KR tone=butter\npin Karakorum 47.2,102.8\nroute West 47.2,102.8|47.5,19",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "map",
          "id": "n1",
          "props": {
            "title": "The Mongol Empire, 1279",
            "caption": "Korea to Hungary."
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "area",
          "id": "n2",
          "in": "n1",
          "props": {
            "codes": [
              "MN",
              "CN",
              "KR"
            ],
            "label": "Empire",
            "tone": "butter"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "pin",
          "id": "n3",
          "in": "n1",
          "props": {
            "at": "47.2,102.8",
            "label": "Karakorum"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "route",
          "id": "n4",
          "in": "n1",
          "props": {
            "pts": [
              "47.2,102.8",
              "47.5,19"
            ],
            "label": "West"
          }
        }
      ]
    },
