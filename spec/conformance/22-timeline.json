    },
    {
      "name": "next: bare words join into text",
      "input": "next Drag   to reorder",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "next",
          "id": "n1",
          "props": {
            "text": "Drag to reorder"
          }
        }
      ]
    },
    {
      "name": "rows with ids and a patch by id",
      "input": "timeline Board\nnow@w65 Timeline\n~w65 sub=\"native view next\"",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "timeline",
          "id": "n1",
          "props": {
            "title": "Board"
