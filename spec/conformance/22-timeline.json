{
  "version": "YL v0",
  "area": "timeline, done, now, next",
  "vectors": [
    {
      "name": "timeline: title, then rows join it in line order",
      "input": "timeline \"Yui this week\"\ndone \"Saved screens\" at=\"Sep 24\" tag=YUI-32\nnow \"Timeline preset\" tag=YUI-65\nnext \"Drag to reorder\" tag=YUI-66",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "timeline",
          "id": "n1",
          "props": {
            "title": "Yui this week"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "done",
          "id": "n2",
          "in": "n1",
          "props": {
            "text": "Saved screens",
            "at": "Sep 24",
            "tag": "YUI-32"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "now",
          "id": "n3",
          "in": "n1",
          "props": {
            "text": "Timeline preset",
            "tag": "YUI-65"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "next",
          "id": "n4",
          "in": "n1",
          "props": {
            "text": "Drag to reorder",
            "tag": "YUI-66"
          }
        }
      ]
    },
    {
      "name": "timeline: no title, mark and fold props",
      "input": "timeline mark=Today fold=3",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "timeline",
          "id": "n1",
          "props": {
            "mark": "Today",
            "fold": 3
          }
        }
      ]
    },
    {
      "name": "timeline: fold=0 shows every done row",
      "input": "timeline Build fold=0",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "timeline",
          "id": "n1",
          "props": {
            "title": "Build",
            "fold": 0
          }
        }
      ]
    },
    {
      "name": "timeline: +reorder and board= for a queue the person can reorder",
      "input": "timeline@war \"War room\" +reorder board=yui\nnow \"Panels\" tag=YUI-73\nnext \"Drag to reorder\" tag=YUI-66\nnext \"Reply to a message\" tag=YUI-68",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "timeline",
          "id": "war",
          "props": {
            "title": "War room",
            "reorder": true,
            "board": "yui"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "now",
          "id": "n1",
          "in": "war",
          "props": {
            "text": "Panels",
            "tag": "YUI-73"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "next",
          "id": "n2",
          "in": "war",
          "props": {
            "text": "Drag to reorder",
            "tag": "YUI-66"
          }
        },
        {
          "op": "add",
          "screen": "1",
          "preset": "next",
          "id": "n3",
          "in": "war",
          "props": {
            "text": "Reply to a message",
            "tag": "YUI-68"
          }
        }
      ]
    },
    {
      "name": "timeline: reorder=off and a quoted board name",
      "input": "timeline \"Trip\" reorder=off board=\"trip plan\"",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "timeline",
          "id": "n1",
          "props": {
            "title": "Trip",
            "reorder": false,
            "board": "trip plan"
          }
        }
      ]
    },
    {
      "name": "next: key= names the row for a reorder and is not text",
      "input": "next \"The gallery X is dead\" tag=Feedback key=t_713f9b94",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "next",
          "id": "n1",
          "props": {
            "text": "The gallery X is dead",
            "tag": "Feedback",
            "key": "t_713f9b94"
          }
        }
      ]
    },
    {
      "name": "done: the first https token is url, anywhere in the line",
      "input": "done Links open Safari https://www.yuigui.com/progress#yui-67 at=\"Sep 25\"",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "done",
          "id": "n1",
          "props": {
            "url": "https://www.yuigui.com/progress#yui-67",
            "text": "Links open Safari",
            "at": "Sep 25"
          }
        }
      ]
    },
    {
      "name": "done: a quoted https token is text, not a url",
      "input": "done \"https://example.com is live\"",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "done",
          "id": "n1",
          "props": {
            "text": "https://example.com is live"
          }
        }
      ]
    },
    {
      "name": "done: only the first https token is url, the second is text",
      "input": "done https://a.example https://b.example",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "done",
          "id": "n1",
          "props": {
            "url": "https://a.example",
            "text": "https://b.example"
          }
        }
      ]
    },
    {
      "name": "done: a relative path is text",
      "input": "done /progress shipped",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "done",
          "id": "n1",
          "props": {
            "text": "/progress shipped"
          }
        }
      ]
    },
    {
      "name": "done: url= key wins over a positional link",
      "input": "done Shipped https://a.example url=https://b.example",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "done",
          "id": "n1",
          "props": {
            "url": "https://b.example",
            "text": "Shipped"
          }
        }
      ]
    },
    {
      "name": "now: sub and tag",
      "input": "now \"Timeline on the war room\" sub=\"web renderer done\" tag=YUI-65",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "now",
          "id": "n1",
          "props": {
            "text": "Timeline on the war room",
