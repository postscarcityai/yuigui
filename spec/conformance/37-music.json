            "p": [
              "x...x...",
              "..x...x.",
              "x.x.x.x."
            ]
          }
        }
      ],
      "resolved": [
        {
          "title": "",
          "bpm": 90,
          "swing": 0,
          "steps": 8,
          "rows": [
            "kick",
            "snare",
            "hat"
          ],
          "p": [
            "x...x...",
            "..x...x.",
            "x.x.x.x."
          ],
          "sound": "pluck",
          "play": true
        }
      ]
    },
