{
  "version": "YL v0",
  "area": "music",
  "vectors": [
    {
      "name": "loop: the first bare number is the tempo, the rest the title",
      "input": "loop 96 \"Boom bap\"",
      "expected": [
        {
          "op": "add",
          "screen": "1",
          "preset": "loop",
          "id": "n1",
          "props": {
            "bpm": 96,
            "title": "Boom bap"
          }
        }
      ],
      "resolved": [
        {
          "title": "Boom bap",
          "bpm": 96,
          "swing": 0,
          "steps": 8,
          "rows": [
            "kick",
            "snare",
            "clap",
            "hat",
            "open",
            "rim",
            "tom",
            "shaker"
          ],
          "p": [],
          "sound": "pluck",
          "play": false
        }
      ]
    },
    {
