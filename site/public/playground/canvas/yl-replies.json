        {
          "find": "next \"Forms on the canvas\"",
          "with": "next \"Forms on the canvas\" at=\"Fri\""
        },
        {
          "find": "next \"Charts on the canvas\"",
          "with": "next \"Charts on the canvas\" at=\"Mon\""
        },
        {
          "find": "next \"Write the note\"",
          "with": "next \"Write the note\" at=\"Tue\""
        }
      ]
    }
