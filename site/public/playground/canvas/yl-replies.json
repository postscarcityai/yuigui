    "say:list:n1:2": [
      {
        "words": [
          "later",
          "not now",
          "after"
        ],
        "name": "Bodyweight squats",
        "mark": "list:n1:3",
        "say": "Squats wait. They go last, struck soft, still there.",
        "replace": [
          {
            "find": "\"Bodyweight squats\"|\"Easy jog\" +num",
            "with": "\"Easy jog\"|\"Bodyweight squats\" +num later=\"Bodyweight squats\""
          }
        ]
      }
    ]
  },
  "queue": {
    "move:tl:n2:4": {
      "to": 3,
      "say": "Ship the build goes first. I moved the dates.",
      "replace": [
        {
          "find": "next \"Ship the build\"",
          "with": "next \"Ship the build\" at=\"Thu\""
