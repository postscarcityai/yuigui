      {
        "near": "yl:plan",
        "say": "Plan comes first. Arrow drawn.",
        "add": [
          "shape arrow from=plan to=build"
        ]
      },
      {
        "near": "yl:test",
        "say": "Test follows Build. Arrow drawn.",
        "add": [
          "shape arrow from=build to=test"
        ]
      }
